package x;

import java.util.Scanner;

public class lab01_prob2 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        String continuar;

        do {
            int valorMes, anio;

            // Leer el mes asegurando que esté en el rango de 1 a 12 y que sea numérico
            while (true) {
                System.out.print("Ingrese un número del 1 al 12 para representar un mes del año: ");
                if (scanner.hasNextInt()) {
                    valorMes = scanner.nextInt();
                    if (valorMes >= 1 && valorMes <= 12) {
                        break; // Sale del bucle si el número es válido
                    }
                } else {
                    scanner.next(); // Limpiar entrada inválida
                }
                System.out.println("Entrada no válida. Intente nuevamente.");
            }

            // Leer el año asegurando que sea un número entero
            while (true) {
                System.out.print("Ingrese el año: ");
                if (scanner.hasNextInt()) {
                    anio = scanner.nextInt();
                    break; // Sale del bucle si el número es válido
                } else {
                    scanner.next(); // Limpiar entrada inválida
                    System.out.println("Entrada no válida. Intente nuevamente.");
                }
            }

            // Obtener el nombre del mes y la cantidad de días 
            String mesNombre = obtenerMes(valorMes);
            int diasMes = obtenerDiasMes(valorMes, anio);

            // Calcular la mitad y su cuadrado
            double mitad = valorMes / 2.0;
            double cuadrado = mitad * mitad;

            // Imprimir resultados
            System.out.println("\nResultados:");
            System.out.println("Mes ingresado: " + valorMes + " - " + mesNombre);
            System.out.println("Días en el mes: " + diasMes);
            System.out.println("Mitad del número ingresado: " + mitad);
            System.out.println("Cuadrado de la mitad: " + cuadrado);

            // Preguntar si desea continuar o salir con validación de "S"/"Si" y "N"/"No"
            scanner.nextLine(); // Limpiar buffer
            do {
                System.out.print("\n¿Desea ingresar otro mes? (S/Si o N/No): ");
                continuar = scanner.nextLine().trim().toLowerCase();
            } while (!continuar.equals("s") && !continuar.equals("si") && !continuar.equals("n") && !continuar.equals("no"));

        } while (continuar.equals("s") || continuar.equals("si"));

        System.out.println("\nCierre del Programa");
        scanner.close();
    }

    // Método para obtener el nombre del mes
    public static String obtenerMes(int numero) {
        if (numero == 1) return "Enero";
        if (numero == 2) return "Febrero";
        if (numero == 3) return "Marzo";
        if (numero == 4) return "Abril";
        if (numero == 5) return "Mayo";
        if (numero == 6) return "Junio";
        if (numero == 7) return "Julio";
        if (numero == 8) return "Agosto";
        if (numero == 9) return "Septiembre";
        if (numero == 10) return "Octubre";
        if (numero == 11) return "Noviembre";
        return "Diciembre"; // Si no es ninguno de los anteriores, es 12
    }

    // Método para obtener la cantidad de días del mes 
    public static int obtenerDiasMes(int mes, int anio) {
        if (mes == 1 || mes == 3 || mes == 5 || mes == 7 || mes == 8 || mes == 10 || mes == 12)
            return 31;
        if (mes == 4 || mes == 6 || mes == 9 || mes == 11)
            return 30;
        if (mes == 2)
            return esBisiesto(anio) ? 29 : 28;
        return -1; // Esto nunca debería ocurrir debido a la validación previa
    }

    // Método para verificar si un año es bisiesto
    public static boolean esBisiesto(int anio) {
        if (anio % 4 == 0) {
            if (anio % 100 == 0) {
                return anio % 400 == 0;
            }
            return true;
        }
        return false;
    }
}
